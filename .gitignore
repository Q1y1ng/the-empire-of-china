# ZCode 会话数据（计划/缓存），不属于项目
.zcode/

# 本机 Windows 文件权限诊断产物（DSH 沙箱 ACL 修复记录），不属于项目
.acl-recovery/

# 本机快捷方式（含绝对路径，仅本机有效；指向 docs/baike/index.html）
百科入口.lnk

# PDF/typst 构建中间产物（本机生成，不入库）
build/

# Python 缓存
__pycache__/


# 精模资产：法线贴图的 PNG 原件（各 20 MB）不入库，同目录已有 quality 92 的 .jpg 版
tools/palace/assets/*_nor_gl.png
